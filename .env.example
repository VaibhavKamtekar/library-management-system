# Server Environment Configuration
NODE_ENV=production
PORT=5000

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=nmitd_library
DB_CONNECTION_LIMIT=10

# Security & CORS (comma-separated or * for dev)
CORS_ORIGIN=*

# Path Overrides (Optional)
# FRONTEND_BUILD_PATH=../frontend/dist
# MYSQL_BIN_DIR=C:\Program Files\MySQL\MySQL Server 8.0\bin

# Backup Configuration (Optional)
# Default: backups/ directory relative to project root
# Can be set to a network path for remote backups (future use)
# BACKUP_DIR=C:\LibraryApp\NMITDLibrary\backups
